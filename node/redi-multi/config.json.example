{
  "debug": false,
  "addr": "0.0.0.0:80",
  "tls_addr": "0.0.0.0:443",
  "api_listen": "127.0.0.1:8080",
  "server_ip": "YOUR_NODE_PUBLIC_IP",
  "default_redirect_url": "https://www.example.com",
  "lagran": {
    "enabled": true,
    "port": "80,443",
    "syn_ack": true,
    "ack": true,
    "window_scale": 7,
    "confusion_times": 0,
    "split_number": 7,
    "window": {
      "80": 1,
      "443": 1
    }
  }
}
