# 复制为 env 并在启动前 export，或使用 systemd EnvironmentFile
REDI_DB_HOST=127.0.0.1
REDI_DB_PORT=3306
REDI_DB_USER=redi_admin
REDI_DB_PASSWORD=change_this_db_password
REDI_DB_NAME=redi_admin
# 节点到主控 MySQL 启用 TLS（需主控 MariaDB 配置 SSL；无法校验证书时用 skip-verify 见文档）
# REDI_DB_TLS=1
# 可选：覆盖 config.json 监听地址（启动前 export）
# REDI_HTTP_LISTEN=0.0.0.0:80
# REDI_TLS_LISTEN=0.0.0.0:443
# REDI_TLS_LISTEN=          # 设为空字符串可关闭 HTTPS
# REDI_API_LISTEN=127.0.0.1:8080
# REDI_MASTER_URL=https://master.example.com
# REDI_NODE_TOKEN=节点管理里的一次性 Token
# REDI_LAGRAN_DISABLED=1   # 关闭 lagran，便于无 CAP_NET_ADMIN 环境调试
