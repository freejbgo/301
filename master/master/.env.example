APP_NAME="301 Master"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-master-domain.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=redi_admin
DB_USERNAME=redi_admin
DB_PASSWORD=change_this_db_password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Dcat 后台是否按 HTTPS 生成链接（生产环境保持 true）
ADMIN_HTTPS=true
