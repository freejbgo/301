APP_NAME="301 Master"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-master-domain.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=redi_admin
DB_USERNAME=redi_admin
DB_PASSWORD=change_this_db_password

BROADCAST_DRIVER=log
# 单台 queue:work 可用 file；多台机器跑证书任务时 WithoutOverlapping 需共享锁，请改为 redis 并配置 REDIS_*
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=database

# 节点 Agent 最低版本（全部 /api/nodes/*；与 redi-multi 0.1.3 一致；设为空可禁用：REDI_MIN_AGENT_VERSION=）
REDI_MIN_AGENT_VERSION=0.1.3

# 租户启用域名前须解析指向平台（CNAME 或 A 到节点池）；平台管理员可跳过
REDI_REQUIRE_DNS_POINTING_TO_ENABLE=true
REDI_DNS_PRECHECK_ALLOW_A_TO_POOL=true

# 可选：redi:health --notify 时 POST JSON（含 issues 与 text 字段）
# issues/hints 的 code 列表见 docs/AUDIT-CENTOS7-PRODUCTION.md §3
# REDI_HEALTH_WEBHOOK_URL=
# 可选：cron 失败等运维告警（未设则与 REDI_HEALTH_WEBHOOK_URL 相同）
# REDI_OPS_WEBHOOK_URL=
# redi:health 判定队列积压的 jobs 表条数阈值（默认 80）
# REDI_HEALTH_QUEUE_PENDING_THRESHOLD=80
# 多 worker 队列见 docs/OPS-MULTI-WORKER-QUEUE.md
# validating 超过 N 小时告警 / 续期重试（默认 2 / 3）
# REDI_HEALTH_VALIDATING_STUCK_HOURS=2
# REDI_RENEW_VALIDATING_STUCK_HOURS=3

# 检测到安装默认后台密码时强制跳转改密（内网演示可设为 false）
# REDI_BLOCK_DEFAULT_ADMIN_PASSWORD=true

SESSION_DRIVER=file
SESSION_LIFETIME=120
# 后台走 HTTPS 时务必 true，避免 Cookie 在非加密连接上发送
SESSION_SECURE_COOKIE=true

# Dcat 后台是否按 HTTPS 生成链接（生产环境保持 true）
ADMIN_HTTPS=true

# 反向代理后信任 X-Forwarded-*（填反代 IP/CIDR；生产环境勿用 *）
# TRUSTED_PROXIES=10.0.0.1
# 仅在主控绝不直连公网时允许 TRUSTED_PROXIES=*（须 true；写入 config 缓存后仍生效）
REDI_ALLOW_TRUST_ALL_PROXIES=false

# 浏览器跨域访问 api/* 时允许的来源，逗号分隔；默认与 APP_URL 一致
# CORS_ALLOWED_ORIGINS=
