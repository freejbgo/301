# 复制为 vars.env：cp vars.example.env vars.env && chmod 600 vars.env
# 主控与节点各一份；节点需填 REDI_NODE_TOKEN。
# 密码、Token、URL 不要包含空格、引号、反引号、$、# 或反斜杠。

MASTER_IP="1.2.3.4"
DB_PASS="YourStrongDbPass_2026"
MYSQL_ROOT_PASS="YourMysqlRootPass"

NODE_IPS="5.6.7.8"

MASTER_INSTALL_ROOT="/opt/301"
NODE_INSTALL_ROOT="/opt/redi-multi"
REDI_MASTER_TAR=""
REDI_NODE_TAR=""

MASTER_URL="http://1.2.3.4"
ADMIN_HTTPS="false"

NODE_PUBLIC_IP="5.6.7.8"
DEFAULT_REDIRECT_URL="https://www.example.com"

REDI_MASTER_URL="https://your-master-domain.com"
REDI_MASTER_INSECURE=""
REDI_DB_TLS=""

REDI_MIN_AGENT_VERSION="0.1.3"
REDI_ALLOW_TRUST_ALL_PROXIES="false"
REDI_NODE_TOKEN=""
