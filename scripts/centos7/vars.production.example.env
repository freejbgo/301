# 生产填空模板（复制为 vars.env 后修改）。实验室 HTTP 联调用 vars.example.env。
#   cp vars.production.example.env vars.env && chmod 600 vars.env && vi vars.env
# 分步教程：docs/DEPLOY-TUTORIAL-CENTOS7.md

MASTER_IP="203.0.113.10"
DB_PASS="YourStrongDbPass_ChangeMe"
MYSQL_ROOT_PASS="YourMysqlRootPass_ChangeMe"

NODE_IPS="203.0.113.20 203.0.113.21"

# 生产必须在 scp 上传 tar 后填写绝对路径（勿依赖机房内自动打包）
REDI_MASTER_TAR="/root/master.tar.gz"
REDI_NODE_TAR="/root/redi-multi.tar.gz"
MASTER_INSTALL_ROOT="/opt/301"
NODE_INSTALL_ROOT="/opt/redi-multi"

MASTER_URL="https://master.example.com"
ADMIN_HTTPS="true"

NODE_PUBLIC_IP="203.0.113.20"
DEFAULT_REDIRECT_URL="https://www.example.com"

REDI_MASTER_URL="https://master.example.com"
# 生产禁止 HTTP Agent；勿设置 REDI_MASTER_INSECURE
REDI_DB_TLS=""

REDI_MIN_AGENT_VERSION="0.1.3"
REDI_ALLOW_TRUST_ALL_PROXIES="false"

# 主控 /opt/301/master/.env 另配（deploy 不自动写入）：
# REDI_HEALTH_WEBHOOK_URL、REDI_OPS_WEBHOOK_URL（见 docs/OPS-RELEASE-UPDATE.md §5）
REDI_NODE_TOKEN=""
