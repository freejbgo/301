# 复制到 /etc/systemd/system/redi-multi.service 后:
#   systemctl daemon-reload && systemctl enable --now redi-multi
#
# lagran 需要 root 或 CAP_NET_ADMIN。不需要时在 env.sh 设置 REDI_LAGRAN_DISABLED=1
# （或 config.json 里 lagran.enabled=false），此时可评估用非 root 用户运行。
# env.sh 中 REDI_CONFIG 指向 config.json；勿将 api_listen 绑到 0.0.0.0（见 DEPLOY-centos7.md）。

[Unit]
Description=301 redirect node (redi-multi)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/redi-multi/redi-multi
EnvironmentFile=/opt/redi-multi/redi-multi/env.sh
ExecStart=/opt/redi-multi/redi-multi/bin/redi-multi
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
