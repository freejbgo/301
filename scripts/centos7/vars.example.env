# 复制为 vars.env 后修改。主控和节点各放一份（节点那份多填 Token）。
#   cp vars.example.env vars.env && chmod 600 vars.env && vi vars.env
#
# 勿将 vars.env 提交到 git（含密码）。
# 密码、Token、URL 不要包含空格、引号、反引号、$、# 或反斜杠。

MASTER_IP="1.2.3.4"
DB_PASS="YourStrongDbPass_2026"
MYSQL_ROOT_PASS="YourMysqlRootPass"

# 空格分隔的节点公网 IP。主控脚本按这个列表授权并放行 3306。
# 第一台主控还没有节点时可以留空，加节点前再写上并重跑 deploy-master.sh。
NODE_IPS="5.6.7.8"

# 自动部署不克隆仓库。源码在 master/master，发布包解压后的程序目录是 /opt/301/master。
# 也可从 GitHub Release 下载 master.tar.gz / redi-multi.tar.gz 后指定绝对路径：
#   REDI_MASTER_TAR=/tmp/master.tar.gz
#   REDI_NODE_TAR=/tmp/redi-multi.tar.gz
MASTER_INSTALL_ROOT="/opt/301"
NODE_INSTALL_ROOT="/opt/redi-multi"
REDI_MASTER_TAR=""
REDI_NODE_TAR=""

# 主控对外地址。只有 IP、还没有证书时用 http，并把 ADMIN_HTTPS 设为 false。
MASTER_URL="http://1.2.3.4"
ADMIN_HTTPS="false"

# 节点机自己的主公网 IP（每台不同，写入该机 config.json 的 server_ip）
NODE_PUBLIC_IP="5.6.7.8"

# config.json 未命中域名时的默认跳转
DEFAULT_REDIRECT_URL="https://www.example.com"

# 节点 Agent 访问主控的地址。有证书后改成 https://主控域名
REDI_MASTER_URL="http://1.2.3.4"
# 后台「节点管理」创建节点后只显示一次。主控脚本不使用这个值。
REDI_NODE_TOKEN=""
