# 复制为 vars.env 后修改。主控和节点各放一份（节点那份多填 Token）。
# 生产 HTTPS 首装模板：vars.production.example.env（须填 REDI_*_TAR，勿设 REDI_MASTER_INSECURE）
# 一条命令安装：docs/DEPLOY-BEGINNER-CENTOS7.md。手工填这份文件时见 DEPLOY-centos7.md。
#   cp vars.example.env vars.env && chmod 600 vars.env && vi vars.env
#
# 勿将 vars.env 提交到 git（含密码）。
# 密码、Token、URL 不要包含空格、引号、反引号、$、# 或反斜杠。

MASTER_IP="1.2.3.4"
DB_PASS="YourStrongDbPass_2026"
MYSQL_ROOT_PASS="YourMysqlRootPass"

# 空格分隔的节点公网 IPv4。主控 deploy-master / grant-nodes-from-vars 按此列表授权 MySQL 并放行 3306。
# 节点公网 IPv6 只在后台「节点管理」填写，禁止写入 NODE_IPS（见 DEPLOY-centos7 §12）。
# 第一台主控还没有节点时可以留空；加节点前写上 IP 并重跑 deploy-master.sh 或 grant-nodes-from-vars.sh。从列表删 IP 或清空后重跑二者之一会撤销授权（见 DEPLOY-centos7 §5）。
NODE_IPS="5.6.7.8"

# 自动部署不克隆仓库。源码在 master/master，发布包解压后的程序目录是 /opt/301/master。
# 一条命令安装用仓库 pkg/，不用填下面两项。
# 自己跑 deploy 时，把 pkg/master.tar.gz、pkg/redi-multi.tar.gz 拷到本机后填写（生产机勿依赖自动打包）：
#   REDI_MASTER_TAR=/tmp/master.tar.gz
#   REDI_NODE_TAR=/tmp/redi-multi.tar.gz
MASTER_INSTALL_ROOT="/opt/301"
NODE_INSTALL_ROOT="/opt/redi-multi"
REDI_MASTER_TAR=""
REDI_NODE_TAR=""

# 实验室/容器：缺 tar 时允许 deploy 在机房内自动 build（生产禁止，须先准备 pkg/ 或 scp 来的 tar）
# REDI_ALLOW_ON_SERVER_TAR_BUILD=1

# 主控对外地址。只有 IP、还没有证书时用 http，并把 ADMIN_HTTPS 设为 false。
MASTER_URL="http://1.2.3.4"
ADMIN_HTTPS="false"

# 节点机自己的主公网 IP（每台不同；deploy 写入 config.json 的 server_ip 供验收，程序不读该字段）
NODE_PUBLIC_IP="5.6.7.8"

# config.json 未命中域名时的默认跳转
DEFAULT_REDIRECT_URL="https://www.example.com"

# 节点 Agent 访问主控。生产须 https://（保护 Token 与证书私钥）。
# 主控尚无证书、仅用 IP 的 HTTP 联调：与 MASTER_URL 一致，并设 REDI_MASTER_INSECURE=1（勿用于生产）。
REDI_MASTER_URL="http://1.2.3.4"
REDI_MASTER_INSECURE="1"
# 可选：节点连库 TLS。1/true=校验证书；skip-verify=仅加密不校验（内网自签）
REDI_DB_TLS=""
# 实验室空 MySQL 密码（生产禁止）：REDI_DB_ALLOW_EMPTY_PASSWORD=1
# 非 loopback 暴露 Echo /api.js（生产禁止）：REDI_API_LISTEN_INSECURE=1
# 可选（不通过 deploy 写入，升级后手工编辑节点 env.sh）：REDI_AGENT_EMPTY_CERT_CLEAR_AFTER=3
# REDI_AGENT_EMPTY_CHALLENGE_CLEAR_AFTER=3、REDI_AGENT_EMPTY_RULES_CLEAR_AFTER=3（见 DEPLOY-centos7 §9、node/redi-multi/env.example）

# 主控 .env：节点 Agent 最低版本（与 redi-multi 0.1.3 一致；留空可写 REDI_MIN_AGENT_VERSION= 禁用门控）
REDI_MIN_AGENT_VERSION="0.1.3"
REDI_ALLOW_TRUST_ALL_PROXIES="false"
# 主控 /opt/301/master/.env 另可配置（deploy 不会从 vars.env 写入，请 SSH 编辑 .env 后 config:cache）：
# REDI_PUBLISH_POOL_AAAA=（默认 false；勿在 deploy 脚本或 vars.env 里写成 true，见 DEPLOY-centos7 §12）
# REDI_HEALTH_WEBHOOK_URL=、REDI_OPS_WEBHOOK_URL=（Cron 08:30 --notify 与失败兜底，见 docs/LAUNCH-CHECKLIST.md）
# 后台「节点管理」创建节点后只显示一次。主控脚本不使用这个值。
REDI_NODE_TOKEN=""
