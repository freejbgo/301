[Unit]
Description=301 Master queue worker (certificates)
After=network.target mariadb.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/301/master
# --tries=100 覆盖等锁；签发异常由任务 $maxExceptions=3 截断
ExecStart=/usr/bin/php artisan queue:work --sleep=3 --timeout=320 --tries=100 --max-time=3600
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
